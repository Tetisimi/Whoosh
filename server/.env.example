# Whoosh Signaling Server — Environment Variables

# Port to listen on (Render sets this automatically)
PORT=3000

# Allowed CORS origin for the frontend (your Vite dev URL or deployed URL)
CLIENT_ORIGIN=http://localhost:5173

# --- Metered.ca TURN credentials ---
# Sign up at https://dashboard.metered.ca/ → Create App → TURN Credentials
# The server exposes these to the client via a /ice-config endpoint
# so your TURN secret is never embedded in client code.
METERED_API_KEY=your_metered_api_key_here
METERED_APP_NAME=your_app_name_here
